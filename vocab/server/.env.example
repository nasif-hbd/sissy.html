# Copy to .env and load it however you like (`node --env-file=.env proxy.mjs`
# on Node 20+, direnv, docker, your host's secret store …).
# Nothing in this file should ever reach the browser.

# One of these, depending on which engine you pick in the app's Settings.
# Neither ever reaches the browser: a key in the browser is a key every visitor
# can read and spend.

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional
PORT=8787
VOCABX_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-2.0-flash-lite

# Lock this to your app's origin in production. Defaults to * for local dev.
# It is the origin the browser loads the app from, with no path and no trailing
# slash — so for a Pages site on a custom domain, exactly this:
# ALLOWED_ORIGIN=https://ylarena.online

# Optional — Web Push. Generate a pair with:  npx web-push generate-vapid-keys
# Without these the app still reminds you locally while a tab is open.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional — where feedback from the app is emailed.
# Without these the note is still written to server/feedback.jsonl; these only
# add the notification. Gmail needs an App Password, not your login password:
# turn on 2-Step Verification, then myaccount.google.com/apppasswords.
# FEEDBACK_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465          # 465 is TLS from the first byte; 587 uses STARTTLS
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=             # defaults to SMTP_USER, which Gmail requires anyway
