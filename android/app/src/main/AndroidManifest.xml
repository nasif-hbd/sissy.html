<?xml version="1.0" encoding="utf-8"?>
<!--
  One activity holding one WebView, which serves the app packed into this APK.
  Nothing else is declared, because nothing else is needed — and every extra
  component in here is another thing that can make an install fail.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the AI assistant, which talks to the proxy. Everything else —
         all 117,000 words, the packs, the grammar bank — is inside the APK and
         works with this permission denied. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.VocabX">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
